  "trauma.injuries": {
    "label": "Injuries found",
    "type": "list",
    "kind": "measure",
    "merge": "accumulate"
  },
  "trauma.criteria": {
    "label": "Trauma criteria described",
    "type": "list",
    "kind": "measure",
    "merge": "accumulate",
    "enum": [
      "penetrating injury head neck torso or proximal extremity",
      "skull deformity",
      "spinal injury with new motor or sensory loss",
      "chest wall instability",
      "pelvic fracture",
      "two or more proximal long bone fractures",
      "crushed degloved mangled or pulseless extremity",
      "amputation proximal to wrist or ankle",
      "bleeding requiring tourniquet or wound packing",
      "respiratory distress or need for respiratory support",
      "ejection",
      "intrusion or extrication",
      "death in same passenger compartment",
      "child unrestrained",
      "rider separated with significant impact",
      "rollover unrestrained",
      "pedestrian or cyclist thrown or run over",
      "fall over 10 feet",
      "time sensitive extremity injury",
      "low level fall with significant head impact",
      "major burn"
    ]
  },
