{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build && mkdir -p dist/app && mv dist/index.html dist/app/index.html && cp dist/landing/index.html dist/index.html",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/app/new", "destination": "/app/?fixture=stroke_demo", "permanent": false },
    { "source": "/app", "destination": "/app/?fixture=stroke_demo", "permanent": false },
    { "source": "/app/", "missing": [{ "type": "query", "key": "fixture" }], "destination": "/app/?fixture=stroke_demo", "permanent": false }
  ]
}
