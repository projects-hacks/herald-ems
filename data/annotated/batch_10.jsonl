{"id": "b10_059", "text": "ignores her whole left side, doesn't know that's her hand, and denies any weakness", "by": "medic", "speaker": null, "facts": [["exam.race.aphasia_agnosia", 2, "medic", null], ["stroke.deficits", ["ignores her whole left side", "doesn't know that's her hand"], "medic", null]], "phenomena": ["asr_noise"]}
{"id": "b10_060", "text": "Understands me fine, follows both commands, just slurred.", "by": "medic", "speaker": null, "facts": [["exam.race.aphasia_agnosia", 0, "medic", null], ["exam.gfast.speech", 1, "medic", null], ["stroke.deficits", ["slurred"], "medic", null]], "phenomena": ["clean"]}
{"id": "b10_061", "text": "uh she's, she's got expressive, no, she's globally aphasic, nothing in nothing out", "by": "medic", "speaker": null, "facts": [["exam.gfast.speech", 1, "medic", null], ["exam.race.aphasia_agnosia", 2, "medic", null], ["stroke.deficits", ["globally aphasic"], "medic", null]], "phenomena": ["disfluency", "correction"]}
{"id": "b10_062", "text": "No drift.", "by": "medic", "speaker": null, "facts": [["exam.gfast.arm_leg", 0, "medic", null], ["exam.race.arm", 0, "medic", null]], "phenomena": ["clean", "negation"]}
