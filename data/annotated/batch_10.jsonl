{"id": "b10_023", "text": "hes got some drift in the right arm i think, maybe not, let me recheck", "by": "medic", "speaker": null, "facts": [], "phenomena": ["uncertain", "no_facts", "asr_noise"]}
{"id": "b10_024", "text": "Right arm is weak but she holds it up the full ten.", "by": "medic", "speaker": null, "facts": [["exam.gfast.arm_leg", 1, "medic", null], ["stroke.deficits", ["right arm is weak"], "medic", null], ["exam.race.arm", 0, "medic", null]], "phenomena": ["clean", "spoken_numbers"]}
{"id": "b10_025", "text": "Left leg is flaccid, can't lift it. Left arm, uh, drifts.", "by": "medic", "speaker": null, "facts": [["exam.gfast.arm_leg", 1, "medic", null], ["exam.race.leg", 2, "medic", null], ["exam.race.arm", 1, "medic", null], ["stroke.deficits", ["left leg is flaccid", "left arm drifts"], "medic", null]], "phenomena": ["disfluency"]}
{"id": "b10_026", "text": "no movement in the right arm or the right leg", "by": "medic", "speaker": null, "facts": [["exam.gfast.arm_leg", 1, "medic", null], ["exam.race.arm", 2, "medic", null], ["exam.race.leg", 2, "medic", null], ["stroke.deficits", ["no movement in the right arm or the right leg"], "medic", null]], "phenomena": ["asr_noise"]}
{"id": "b10_027", "text": "Arms fine.", "by": "medic", "speaker": null, "facts": [["exam.race.arm", 0, "medic", null]], "phenomena": ["clean"]}
