{"id": "b10_055", "text": "aphasia zero but his speech is slurred", "by": "medic", "speaker": null, "facts": [["exam.race.aphasia_agnosia", 0, "medic", null], ["exam.gfast.speech", 1, "medic", null], ["stroke.deficits", ["speech is slurred"], "medic", null]], "phenomena": ["asr_noise", "spoken_numbers"]}
{"id": "b10_056", "text": "Agnosia score one.", "by": "medic", "speaker": null, "facts": [["exam.race.aphasia_agnosia", 1, "medic", null]], "phenomena": ["clean", "spoken_numbers"]}
{"id": "b10_057", "text": "severe dysarthria, can barely understand him, but he names the pen and the watch", "by": "medic", "speaker": null, "facts": [["exam.gfast.speech", 1, "medic", null], ["stroke.deficits", ["severe dysarthria"], "medic", null]], "phenomena": ["asr_noise"]}
