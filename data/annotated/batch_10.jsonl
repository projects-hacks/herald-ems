{"id": "b10_064", "text": "Face symmetric, arms and legs strong, speech clear, eyes midline.", "by": "medic", "speaker": null, "facts": [["exam.gfast.facial", 0, "medic", null], ["exam.race.facial", 0, "medic", null], ["exam.gfast.arm_leg", 0, "medic", null], ["exam.race.arm", 0, "medic", null], ["exam.race.leg", 0, "medic", null], ["exam.gfast.speech", 0, "medic", null], ["exam.gfast.gaze", 0, "medic", null], ["exam.race.gaze", 0, "medic", null]], "phenomena": ["negation", "multi_event"]}
