{"id": "b10_036", "text": "Head and eyes are turned to the right.", "by": "medic", "speaker": null, "facts": [["exam.gfast.gaze", 1, "medic", null], ["exam.race.gaze", 1, "medic", null], ["stroke.deficits", ["head and eyes turned to the right"], "medic", null]], "phenomena": ["clean"]}
{"id": "b10_037", "text": "He can't look to the left, stops at midline.", "by": "medic", "speaker": null, "facts": [["exam.gfast.gaze", 1, "medic", null], ["stroke.deficits", ["can't look to the left"], "medic", null]], "phenomena": ["clean"]}
