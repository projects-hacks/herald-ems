{"id": "b10_009", "text": "Facial droop left, correction, it's a mild droop on the left.", "by": "medic", "speaker": null, "facts": [["exam.gfast.facial", 1, "medic", null], ["exam.race.facial", 1, "medic", null], ["stroke.deficits", ["mild droop on the left"], "medic", null]], "phenomena": ["correction"]}
{"id": "b10_010", "text": "severe rt facial droop noted", "by": "medic", "speaker": null, "facts": [["exam.gfast.facial", 1, "medic", null], ["exam.race.facial", 2, "medic", null], ["stroke.deficits", ["severe rt facial droop"], "medic", null]], "phenomena": ["shorthand", "asr_noise"]}
{"id": "b10_011", "text": "I'd call the droop moderate not mild, lower right face", "by": "medic", "speaker": null, "facts": [["exam.gfast.facial", 1, "medic", null], ["exam.race.facial", 2, "medic", null], ["stroke.deficits", ["moderate droop lower right face"], "medic", null]], "phenomena": ["asr_noise"]}
{"id": "b10_012", "text": "Left arm drifts, down before ten seconds.", "by": "medic", "speaker": null, "facts": [["exam.gfast.arm_leg", 1, "medic", null], ["exam.race.arm", 1, "medic", null], ["stroke.deficits", ["left arm drifts"], "medic", null]], "phenomena": ["clean", "spoken_numbers"]}
