{"id": "b10_014", "text": "She can't lift the right arm off the stretcher at all.", "by": "medic", "speaker": null, "facts": [["exam.gfast.arm_leg", 1, "medic", null], ["exam.race.arm", 2, "medic", null], ["stroke.deficits", ["can't lift the right arm"], "medic", null]], "phenomena": ["clean"]}
{"id": "b10_015", "text": "left arm is flaccid", "by": "medic", "speaker": null, "facts": [["exam.gfast.arm_leg", 1, "medic", null], ["exam.race.arm", 2, "medic", null], ["stroke.deficits", ["left arm is flaccid"], "medic", null]], "phenomena": ["asr_noise"]}
{"id": "b10_016", "text": "Left leg drifts, but the left arm holds.", "by": "medic", "speaker": null, "facts": [["exam.gfast.arm_leg", 1, "medic", null], ["exam.race.leg", 1, "medic", null], ["stroke.deficits", ["left leg drifts"], "medic", null], ["exam.race.arm", 0, "medic", null]], "phenomena": ["clean"]}
{"id": "b10_017", "text": "right leg, can't get it off the bed, no movement", "by": "medic", "speaker": null, "facts": [["exam.gfast.arm_leg", 1, "medic", null], ["exam.race.leg", 2, "medic", null], ["stroke.deficits", ["can't get right leg off the bed"], "medic", null]], "phenomena": ["asr_noise"]}
{"id": "b10_018", "text": "he lifts the left leg but it falls back to the bed in like three seconds", "by": "medic", "speaker": null, "facts": [["exam.gfast.arm_leg", 1, "medic", null], ["exam.race.leg", 1, "medic", null], ["stroke.deficits", ["left leg falls back to the bed"], "medic", null]], "phenomena": ["asr_noise", "spoken_numbers"]}
{"id": "b10_019", "text": "Arms and legs strong bilaterally, no drift.", "by": "medic", "speaker": null, "facts": [["exam.gfast.arm_leg", 0, "medic", null], ["exam.race.arm", 0, "medic", null], ["exam.race.leg", 0, "medic", null]], "phenomena": ["clean", "negation"]}
{"id": "b10_020", "text": "There's weakness in the right arm.", "by": "medic", "speaker": null, "facts": [["exam.gfast.arm_leg", 1, "medic", null], ["stroke.deficits", ["weakness in the right arm"], "medic", null]], "phenomena": ["clean"]}
{"id": "b10_021", "text": "left arm um it's plegic, zero movement, and the left leg drifts", "by": "medic", "speaker": null, "facts": [["exam.gfast.arm_leg", 1, "medic", null], ["exam.race.arm", 2, "medic", null], ["exam.race.leg", 1, "medic", null], ["stroke.deficits", ["left arm plegic", "left leg drifts"], "medic", null]], "phenomena": ["disfluency", "asr_noise"]}
