{"id": "b10_006", "text": "face is pretty much symmetric, maybe a little flat on the right, honestly hard to say", "by": "medic", "speaker": null, "facts": [], "phenomena": ["uncertain", "no_facts"]}
{"id": "b10_007", "text": "no facial droop", "by": "medic", "speaker": null, "facts": [["exam.gfast.facial", 0, "medic", null], ["exam.race.facial", 0, "medic", null]], "phenomena": ["negation", "asr_noise"]}
