{"id": "b10_001", "text": "Face is symmetric, smile is even on both sides.", "by": "medic", "speaker": null, "facts": [["exam.gfast.facial", 0, "medic", null], ["exam.race.facial", 0, "medic", null]], "phenomena": ["clean", "negation"]}
