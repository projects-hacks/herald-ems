{"id": "b10_066", "text": "She denies any weakness.", "by": "medic", "speaker": null, "facts": [], "phenomena": ["no_facts", "attribution"]}
{"id": "b10_067", "text": "no neglect, no aphasia, following commands", "by": "medic", "speaker": null, "facts": [["exam.race.aphasia_agnosia", 0, "medic", null]], "phenomena": ["negation", "asr_noise"]}
{"id": "b10_068", "text": "Facial droop? No. Arm drift? No. Speech, clear.", "by": "medic", "speaker": null, "facts": [["exam.gfast.facial", 0, "medic", null], ["exam.race.facial", 0, "medic", null], ["exam.race.arm", 0, "medic", null], ["exam.gfast.speech", 0, "medic", null]], "phenomena": ["negation"]}
{"id": "b10_069", "text": "moves all extremities equally, face symmetric", "by": "medic", "speaker": null, "facts": [["exam.gfast.arm_leg", 0, "medic", null], ["exam.gfast.facial", 0, "medic", null], ["exam.race.facial", 0, "medic", null]], "phenomena": ["negation", "asr_noise"]}
