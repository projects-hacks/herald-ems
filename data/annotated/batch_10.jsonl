{"id": "b10_029", "text": "Left arm drifts, no wait, she can't lift it at all.", "by": "medic", "speaker": null, "facts": [["exam.gfast.arm_leg", 1, "medic", null], ["exam.race.arm", 2, "medic", null], ["stroke.deficits", ["can't lift left arm at all"], "medic", null]], "phenomena": ["correction"]}
{"id": "b10_030", "text": "left upper extremity drifts to the bed but she gets it up first", "by": "medic", "speaker": null, "facts": [["exam.gfast.arm_leg", 1, "medic", null], ["exam.race.arm", 1, "medic", null], ["stroke.deficits", ["left upper extremity drifts to the bed"], "medic", null]], "phenomena": ["asr_noise"]}
{"id": "b10_031", "text": "R leg weak, L leg normal", "by": "medic", "speaker": null, "facts": [["exam.gfast.arm_leg", 1, "medic", null], ["stroke.deficits", ["R leg weak"], "medic", null]], "phenomena": ["shorthand"]}
{"id": "b10_032", "text": "Eyes are midline.", "by": "medic", "speaker": null, "facts": [["exam.gfast.gaze", 0, "medic", null], ["exam.race.gaze", 0, "medic", null]], "phenomena": ["clean", "negation"]}
{"id": "b10_033", "text": "gaze deviated to the left", "by": "medic", "speaker": null, "facts": [["exam.gfast.gaze", 1, "medic", null], ["exam.race.gaze", 1, "medic", null], ["stroke.deficits", ["gaze deviated to the left"], "medic", null]], "phenomena": ["asr_noise"]}
{"id": "b10_034", "text": "She's looking hard to the right, won't cross midline for me.", "by": "medic", "speaker": null, "facts": [["exam.gfast.gaze", 1, "medic", null], ["exam.race.gaze", 1, "medic", null], ["stroke.deficits", ["looking hard to the right"], "medic", null]], "phenomena": ["clean"]}
