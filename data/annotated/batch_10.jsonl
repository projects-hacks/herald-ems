{"id": "b10_039", "text": "eyes deviated rt, they were midline when we got here", "by": "medic", "speaker": null, "facts": [["exam.gfast.gaze", 1, "medic", null], ["exam.race.gaze", 1, "medic", null], ["stroke.deficits", ["eyes deviated rt"], "medic", null]], "phenomena": ["shorthand", "asr_noise"]}
