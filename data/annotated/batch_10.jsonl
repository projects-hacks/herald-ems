{"id": "b10_003", "text": "Mild left facial droop.", "by": "medic", "speaker": null, "facts": [["exam.gfast.facial", 1, "medic", null], ["exam.race.facial", 1, "medic", null], ["stroke.deficits", ["mild left facial droop"], "medic", null]], "phenomena": ["clean"]}
