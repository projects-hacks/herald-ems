{"id": "b11_116", "text": "my dad takes eloquis and he was totally fine at noon, I'm sure of it", "by": "other", "speaker": "daughter", "facts": [["meds.anticoagulant", "apixaban", "family", "daughter"], ["meds.list", ["apixaban"], "family", "daughter"], ["stroke.lkw", "noon", "family", "daughter"]], "phenomena": ["other_speaker", "asr_noise", "brand_names"]}
