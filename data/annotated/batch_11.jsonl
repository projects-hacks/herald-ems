{"id": "b11_074", "text": "Wife states he was fine at one-oh-five after lunch.", "by": "medic", "speaker": null, "facts": [["stroke.lkw", "1:05", "family", "wife"]], "phenomena": ["spoken_numbers", "attribution"]}
{"id": "b11_075", "text": "she was fine at nine, no wait, it was nine thirty, I called her after my meeting", "by": "other", "speaker": "daughter", "facts": [["stroke.lkw", "9:30", "family", "daughter"]], "phenomena": ["other_speaker", "correction", "spoken_numbers"]}
