{"id": "b11_072", "text": "Onset at oh-eight-twenty, witnessed by his coworker. Right facial droop has resolved, right arm still drifting.", "by": "medic", "speaker": null, "facts": [["symptom.onset", "0820", "medic", null], ["stroke.onset_witnessed", true, "bystander", null], ["exam.gfast.facial", 0, "medic", null], ["exam.race.facial", 0, "medic", null], ["exam.gfast.arm_leg", 1, "medic", null], ["exam.race.arm", 1, "medic", null], ["stroke.deficits", ["right arm still drifting"], "medic", null]], "phenomena": ["spoken_numbers", "attribution", "multi_event"]}
