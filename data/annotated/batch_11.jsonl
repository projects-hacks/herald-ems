{"id": "b11_077", "text": "Pulse one forty, sats ninety-one on room air.", "by": "medic", "speaker": null, "facts": [["vitals.hr", 140, "medic", null], ["vitals.spo2", 91, "medic", null], ["vitals.on_oxygen", false, "medic", null]], "phenomena": ["spoken_numbers", "shorthand"]}
{"id": "b11_078", "text": "Found down at the bottom of the stairs, obvious deformity to the left wrist, can't move his legs, c-spine precautions.", "by": "medic", "speaker": null, "facts": [["complaint.chief", "found down at the bottom of the stairs", "medic", null]], "phenomena": ["multi_event"]}
{"id": "b11_079", "text": "BGL twenty-eight, found down by his roommate, diaphoretic and confused.", "by": "medic", "speaker": null, "facts": [["vitals.glucose", 28, "medic", null], ["complaint.chief", "found down", "bystander", null], ["vitals.consciousness", "C", "medic", null]], "phenomena": ["shorthand", "spoken_numbers", "attribution"]}
{"id": "b11_080", "text": "she was checking out and just stopped mid-sentence and stared off to the right and wouldn't answer me", "by": "other", "speaker": "store manager", "facts": [["stroke.onset_witnessed", true, "bystander", null], ["stroke.deficits", ["stopped mid-sentence", "stared off to the right"], "bystander", null]], "phenomena": ["other_speaker"]}
{"id": "b11_081", "text": "Seventy-nine male, LKW oh-five-thirty per group home staff, right arm weak.", "by": "medic", "speaker": null, "facts": [["patient.age", 79, "medic", null], ["patient.sex", "M", "medic", null], ["stroke.lkw", "0530", "family", "caregiver"], ["exam.gfast.arm_leg", 1, "medic", null], ["stroke.deficits", ["right arm weak"], "medic", null]], "phenomena": ["shorthand", "spoken_numbers", "attribution"]}
{"id": "b11_082", "text": "She lay down for a nap at one thirty feeling normal and woke up at three with a left facial droop.", "by": "medic", "speaker": null, "facts": [["stroke.lkw", "1:30", "medic", null], ["stroke.onset_witnessed", false, "medic", null], ["exam.gfast.facial", 1, "medic", null], ["exam.race.facial", 2, "medic", null], ["stroke.deficits", ["left facial droop"], "medic", null]], "phenomena": ["spoken_numbers", "multi_event"]}
{"id": "b11_083", "text": "LKW maybe around ten, the wife isn't sure.", "by": "medic", "speaker": null, "facts": [], "phenomena": ["uncertain", "shorthand", "no_facts"]}
{"id": "b11_084", "text": "I was fine until about eleven, then my right leg just gave out walking to the car", "by": "other", "speaker": "patient", "facts": [["stroke.lkw", "11", "patient", null], ["stroke.deficits", ["right leg gave out"], "patient", null]], "phenomena": ["other_speaker", "spoken_numbers"]}
{"id": "b11_085", "text": "Blood pressure two-ten over one-twenty, LKW nineteen hundred, she's on Xarelto.", "by": "medic", "speaker": null, "facts": [["vitals.sbp", 210, "medic", null], ["vitals.dbp", 120, "medic", null], ["stroke.lkw", "1900", "medic", null], ["meds.anticoagulant", "rivaroxaban", "medic", null], ["meds.list", ["rivaroxaban"], "medic", null]], "phenomena": ["spoken_numbers", "brand_names", "multi_event"]}
{"id": "b11_086", "text": "Sudden onset garbled speech, witnessed, about ten minutes prior to our arrival.", "by": "medic", "speaker": null, "facts": [["exam.gfast.speech", 1, "medic", null], ["stroke.deficits", ["garbled speech"], "medic", null], ["stroke.onset_witnessed", true, "medic", null], ["symptom.onset", "10 minutes prior to our arrival", "medic", null]], "phenomena": ["spoken_numbers"]}
{"id": "b11_087", "text": "He was watching TV and I was in the kitchen. When I came back he was slumped over and his words were mush.", "by": "other", "speaker": "wife", "facts": [["stroke.onset_witnessed", false, "family", "wife"], ["stroke.deficits", ["words were mush"], "family", "wife"]], "phenomena": ["other_speaker"]}
{"id": "b11_088", "text": "Daughter witnessed the whole thing, says he grabbed his head and slumped to the left. Now he's got left-sided neglect.", "by": "medic", "speaker": null, "facts": [["stroke.onset_witnessed", true, "family", "daughter"], ["stroke.deficits", ["left-sided neglect"], "medic", null]], "phenomena": ["attribution"]}
{"id": "b11_089", "text": "Okay we're gonna load and go, let's get her on the stretcher.", "by": "medic", "speaker": null, "facts": [], "phenomena": ["no_facts"]}
{"id": "b11_090", "text": "last known well is uh, is sixteen forty-five, per the nurse at the facility", "by": "medic", "speaker": null, "facts": [["stroke.lkw", "16:45", "family", "nurse"]], "phenomena": ["disfluency", "spoken_numbers", "attribution"]}
{"id": "b11_091", "text": "She was at her baseline at the 2 am rounds. At 4 am she wasn't moving her right side.", "by": "other", "speaker": "nurse", "facts": [["stroke.lkw", "2 am", "family", "nurse"], ["stroke.deficits", ["wasn't moving her right side"], "family", "nurse"]], "phenomena": ["other_speaker"]}
{"id": "b11_092", "text": "Chest pain since two this afternoon, radiates to the left arm, no weakness.", "by": "medic", "speaker": null, "facts": [["complaint.chief", "chest pain", "medic", null], ["symptom.onset", "since 2 pm", "medic", null]], "phenomena": ["negation", "spoken_numbers"]}
{"id": "b11_093", "text": "Pt found by husband at 0700, last known well 2330 when they went to bed, pt is aphasic.", "by": "medic", "speaker": null, "facts": [["stroke.onset_witnessed", false, "family", "husband"], ["stroke.lkw", "2330", "medic", null], ["exam.gfast.speech", 1, "medic", null], ["exam.race.aphasia_agnosia", 2, "medic", null], ["stroke.deficits", ["aphasic"], "medic", null]], "phenomena": ["shorthand", "attribution", "multi_event"]}
{"id": "b11_094", "text": "Is this a wake-up? Yeah, sounds like she maybe woke up with it.", "by": "medic", "speaker": null, "facts": [], "phenomena": ["uncertain", "no_facts"]}
{"id": "b11_095", "text": "I was on facetime with her at eight fifteen and she was normal, then at like eight thirty the side of her face just dropped while we were talking", "by": "other", "speaker": "son", "facts": [["stroke.lkw", "8:15", "family", "son"], ["symptom.onset", "8:30", "family", "son"], ["stroke.deficits", ["side of her face just dropped"], "family", "son"], ["stroke.onset_witnessed", true, "family", "son"]], "phenomena": ["other_speaker", "spoken_numbers", "multi_event"]}
