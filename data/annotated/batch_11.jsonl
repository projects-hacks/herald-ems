{"id": "b11_122", "text": "He says he was normal until he stood up at seven, then his left leg buckled.", "by": "medic", "speaker": null, "facts": [["stroke.lkw", "7", "patient", null], ["stroke.deficits", ["left leg buckled"], "medic", null]], "phenomena": ["attribution", "spoken_numbers"]}
