{"id": "b11_112", "text": "Fifty-five yo female, sudden vertigo and she can't walk without veering left, started at noon, witnessed by her sister.", "by": "medic", "speaker": null, "facts": [["patient.age", 55, "medic", null], ["patient.sex", "F", "medic", null], ["complaint.chief", "vertigo", "medic", null], ["stroke.deficits", ["can't walk without veering left"], "medic", null], ["symptom.onset", "noon", "medic", null], ["stroke.onset_witnessed", true, "family", "sister"]], "phenomena": ["shorthand", "spoken_numbers", "attribution", "multi_event"]}
