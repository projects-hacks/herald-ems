    "stemi": {
      "label": "STEMI Alert",
      "source": "700-A08 §1, §3.2, §6 (effective 2025-01-01); 700-M09 §3.1, §4.9 (effective 2024-01-01); Policy 501 §IV; Policy 602 §VI.F",
      "items": [
        {
          "key": "ecg.stemi_reading",
