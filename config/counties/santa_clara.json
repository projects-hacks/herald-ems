    "routing": {
      "gfast": {
        "positive": "4 of 4: Comprehensive Stroke Center; closest Primary Stroke Center if transport to the closest Comprehensive Stroke Center is over 45 minutes (700-A13 §3.2, §3.2.1)",
        "negative": "3 or fewer: closest Stroke Center, Comprehensive or Primary (700-A13 §3.3)"
      }
    },
    "protocol_notes": [
      "Stroke Alert if the time last known well is within 24 hours (700-A13 §3.1)",
      "Last known well must be specific; before bedtime means the bedtime, not the wake-up time (700-A13 §6.1)",
      "Seizure during stroke symptoms: protocol 700-A02, not stroke routing (700-A13 §2.4)",
      "Glucose below 60 mg/dL: protocol 700-A03 (700-S04 §2.9)"
    ]
  },
  "alerts": {
    "trauma": {
      "label": "Trauma Alert",
      "source": "Policy 605 §II.B (in AO 2025-005, effective 2025-04-01); Policy 501 §IV.E (effective 2025-01-01); Policy 602 §VI.C (effective 2025-04-01)",
      "score": "trauma_605",
      "items": [
        {
          "key": "trauma.mechanism",
          "label": "Mechanism of injury",
          "source": "501 §IV.E.1 \"State the Mechanism of Injury according to Santa Clara County Prehospital Care Policy #605\"; 700-A16 §6.1"
        },
        {
          "key": "@trauma_605",
          "label": "Trauma criteria (Policy 605)",
          "source": "501 §IV.E.2 \"State the Anatomic and Physiologic Trauma Criteria for transport to a trauma center according to Santa Clara County Prehospital Care Policy #605\"; 602 §VI.C"
        },
        {
          "key": "vitals.gcs_total|vitals.gcs_motor",
          "label": "GCS",
          "source": "700-S04 §2.2 (GCS on every patient and every reassessment); 700-A16 §6.3; 605 §II.B J"
        },
        {
          "key": "vitals.sbp",
          "label": "Systolic BP",
          "source": "605 §II.B N.1-N.3; 501 §III.A.4"
        },
        {
          "key": "vitals.hr",
          "label": "Heart rate",
          "source": "605 §II.B N.4; 501 §III.A.4"
        },
        {
          "key": "vitals.rr",
          "label": "Respiratory rate",
          "source": "605 §II.B K; 501 §III.A.4"
        },
        {
          "key": "vitals.spo2",
          "label": "SpO2",
          "source": "605 §II.B M (room air); 501 §III.A.4"
        },
        {
          "key": "meds.anticoagulant",
          "label": "Anticoagulants",
          "source": "605 §II.B X.1; 700-S06 §3.3"
        },
        {
          "key": "patient.pregnancy_weeks",
          "label": "Pregnancy (weeks)",
          "source": "602 §VI.C.4 (pregnant trauma alert patients over 20 weeks: trauma center with a Level III NICU); 605 §II.B X.7. Listed unless the patient is known to be male or outside ages 10-55 (Herald display rule, config/checklists.yaml)",
          "when": {
            "type": "all_of",
            "rules": [
              {
                "type": "one_of",
                "key": "patient.sex",
                "values": [
                  "F",
                  "female"
                ]
              },
              {
                "type": "between",
                "key": "patient.age",
                "low": 10,
                "high": 55
              }
            ]
          }
        },
        {
          "key": "transport.destination",
          "label": "Destination",
          "source": "602 §VI.C.2-3, Table B"
        },
        {
          "key": "transport.eta_min",
          "label": "ETA",
          "source": "501 §III.A.1.b"
        }
      ],
      "open_on": {
        "scores": [
          "trauma_605"
        ]
      },
      "unknowns": [
        "meds.anticoagulant",
        "allergies"
      ],
      "county_rules": [
        {
          "text": "Adult Trauma Alert Patients shall be transported to the closest open Adult Trauma Center, identified in Table B: Approved In-County Services, determined by distance or time of travel. (602 §VI.C.2)",
          "when": {
            "type": "between",
            "key": "patient.age",
            "low": 15
          }
        },
        {
          "text": "Pediatric Trauma Alert Patients shall be transported to the closest open Pediatric Trauma Center, identified in Table B: Approved In-County Services, determined by distance or time of travel. (602 §VI.C.3; pediatric: less than 15 years of age, 602 §VI.H)",
          "when": {
            "type": "below",
            "key": "patient.age",
            "value": 15
          }
        },
        {
          "text": "Pregnant trauma alert patients more than twenty (20) weeks gestation are to be transported to the closest trauma center with an approved Level III Neonatal ICU (Stanford Hospital or Santa Clara Valley Medical Center). (602 §VI.C.4)",
          "when": {
            "type": "above",
            "key": "patient.pregnancy_weeks",
            "value": 20
          }
        },
        {
          "text": "Burn Patients – Patients meeting major burn criteria as per Santa Clara County Prehospital Care Policy #605: Prehospital Trauma Triage shall be transported to the Burn Center at Santa Clara Valley Medical Center (VMC) via the Trauma Center. (602 §VI.D)",
          "when": {
            "type": "contains",
            "key": "trauma.criteria",
            "value": "major burn"
          }
        }
      ]
    },
    "sepsis": {
      "label": "Sepsis pre-notification",
