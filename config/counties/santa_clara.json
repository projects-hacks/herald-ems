        },
        {
          "key": "ecg.twelve_lead_time",
          "label": "First 12-lead time",
          "source": "700-A08 §6.2 \"Time of first 12 Lead ECG\"; §1.1 (within 10 minutes of patient contact); 700-M09 §4.1"
        },
        {
          "key": "ecg.transmitted",
          "label": "12-lead transmitted to the STEMI center",
          "source": "700-A08 §1.4, §3.2.2; 700-M09 §4.9.1.1; Policy 430 §VII.A.5"
        },
        {
          "key": "vitals.sbp",
          "label": "Systolic BP",
          "source": "501 §III.A.4"
        },
        {
          "key": "allergies",
          "label": "Allergies",
          "source": "501 §III.A.3"
        },
        {
          "key": "meds.given[drug=aspirin]",
          "label": "Time of aspirin administration",
          "note": "not recorded",
          "source": "700-A08 §6.3, a Key Documentation Element (documentation only)"
        }
      ],
      "triggers": [
        "chest pain",
        "stemi",
        "mi ",
        "heart attack",
        "acs",
        "st elevation",
        "acute mi",
        "substernal",
        "chest pressure",
        "chest tightness",
        "impending doom"
      ],
      "triggers_source": "Default STEMI words plus 700-M09 §3.1 chest findings: §3.1.1 \"Substernal pain\", §3.1.2 \"Discomfort or tightness\", §3.1.10 \"Anxiety with feeling of impending doom\"",
      "open_on": {
        "facts": [
          {
            "type": "present",
            "key": "ecg.stemi_reading",
            "unless": [
              "false"
            ]
          }
        ]
      },
      "unknowns": [
        "symptom.onset",
        "allergies",
        "meds.anticoagulant"
      ]
    }
